/* css/style.css */
* { margin: 0; padding: 0; box-sizing: border-box; }
body { font-family: 'Georgia', serif; color: #333; }
.navbar { background: #1a1a1a; color: white; padding: 20px; }
.hero { height: 100vh; background: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.5)), url('bg.jpg'); display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center; color: white; }
button { padding: 15px 40px; background: #d4af37; border: none; cursor: pointer; font-size: 16px; }
.menu { padding: 60px 20px; }
